#write test.zig {
// We don't support coercing non-vectors to vectors when doing concatenation to avoid complicating
// RLS, once RLS can propagate result types across binary expresions these error tests will instead
// become behavior tests.
export fn vecArray() void {
    _ = @Vector(2, f32){ 1, 2 } ++ [2]f32{ 3, 4 };
}
export fn arrayVec() void {
    _ = [2]f32{ 3, 4 } ++ @Vector(2, f32){ 1, 2 };
}
export fn tupleVec() void {
    _ = struct{f32, f32}{ 3, 4 } ++ @Vector(2, f32){ 1, 2 };
}
export fn vecTuple() void {
    _ = @Vector(2, f32){ 1, 2 } ++ struct{f32, f32}{ 3, 4 };
}
#}
