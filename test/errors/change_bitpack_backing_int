#zig build-obj {
--name test -fno-emit-bin
-Mroot=test.zig
#}

#write test.zig {
const Foo = bitpack struct(u8) { a: u4, b: i4 };
const Bar = bitpack union(u10) { a: u10, b: i10 };
comptime {
    @compileLog(@typeInfo(Foo).@"struct".backing_integer.?);
}
comptime {
    @compileLog(@bitSizeOf(Bar));
}
const std = @import("std");
const io = std.Io.Threaded.global_single_threaded.io();
#}
#update
#check errors {
test.zig:4:5: error: found compile log statement
test.zig:7:5: note: also here

Compile Log Output:
@as(type, u8)
@as(comptime_int, 10)
#}

