#obj {
--name test -fno-lld -fno-new-linker -ofmt=llvmir
-Mroot=test.zig
#}

#write test.zig {
export fn entry(arr: *const [16]u8) @Vector(16, u8) {
    return arr.*;
}
#}
#update "one vector load"
#check llvm {
define #...<16 x i8> @test.entry(#...) #...{
#...
  %1 = alloca [16 x i8], align 1#...
  %3 = load <16 x i8>, ptr %1, align 1#...
  ret <16 x i8> %3#...
#}

#write test.zig {
export fn entry(a: *@Vector(8, u8), b: *@Vector(8, u8), src: [*]const u8) void {
    const q: @Vector(16, u8) = src[0..16].*;
    a.* = @shuffle(u8, q, undefined, @Vector(8, i32){ 0, 1, 2, 3, 4, 5, 6, 7 });
    b.* = @shuffle(u8, q, undefined, @Vector(8, i32){ 7, 8, 9, 10, 11, 12, 13, 14 });
}
#}
#update "feeding overlapping shuffles"
#check llvm {
define #...void @test.entry(ptr #...%0, ptr #...%1, #...) #...{
#...
  %11 = load <16 x i8>, ptr %#...
  %12 = shufflevector <16 x i8> %11, #...
  store <8 x i8> %12, ptr %0, align 8#...
  %13 = shufflevector <16 x i8> %11, #...
  store <8 x i8> %13, ptr %1, align 8#...
  ret void#...
}
#}
