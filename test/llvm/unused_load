#obj {
--name test -fno-lld -fno-new-linker -ofmt=llvmir
-Mroot=test.zig
#}

#write test.zig {
export fn entry(ptr: *i16) void {
    _ = @atomicLoad(i16, ptr, .acquire);
}
#}
#update "atomic acquire"
#check llvm {
define #...@test.entry(ptr #...%0) #...{
#...load atomic i16, ptr %0 acquire#...
}

#}

#write test.zig {
export fn entry(ptr: *volatile i16) void {
    _ = @atomicLoad(i16, ptr, .unordered);
}
#}
#update "atomic volatile unordered"
#check llvm {
define #...@test.entry(ptr #...%0) #...{
#...load atomic volatile i16, ptr %0 unordered#...
}

#}

#write test.zig {
export fn entry(ptr: *volatile i16) void {
    _ = ptr.*;
}
#}
#update "volatile"
#check llvm {
define #...@test.entry(ptr #...%0) #...{
#...load volatile i16, ptr %0#...
}

#}

#write test.zig {
export fn entry(ptr: *volatile i16) void {
    entry2(ptr[0..1]);
}
fn entry2(slice: []volatile i16) void {
    @setRuntimeSafety(false);
    _ = slice[0];
}
#}
#update "volatile slice"
#check llvm {
define #...@test.entry(#...) #...{
#...
}

#...
define #...@test.entry2(#...) #...{
#...load volatile i16, ptr %#...
}

#}

