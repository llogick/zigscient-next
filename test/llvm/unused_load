#zig build-obj {
--name test -ofmt=llvmir -fno-lld -fno-new-linker
-Mroot=test.zig
#}

#write test.zig {
export fn entry(ptr: *i16) void {
    _ = @atomicLoad(i16, ptr, .acquire);
}
#}
#update "atomic acquire"
#check llvm {
...
define ... @test.entry(ptr ... %ptr) ... {
  ...
  %ptr.load = load atomic i16, ptr %ptr ... acquire, align ?, !...
  ...
}

...
#}

