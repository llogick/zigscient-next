#obj {
--name test -fno-lld -fno-new-linker -ofmt=llvmir
-Mroot=test.zig
#}

#write test.zig {
export fn entry(ptr: *volatile i16) void {
    ptr.* = 123;
    ptr.* = 321;
}
#}
#update "volatile"
#check llvm {
define #...@test.entry(ptr #...%0) #...{
#...store volatile i16 123, ptr %0#...
#...store volatile i16 321, ptr %0#...
}

#}

#write test.zig {
export fn entry(ptr: *volatile i16) void {
    entry2(ptr[0..1]);
}
fn entry2(slice: []volatile i16) void {
    @setRuntimeSafety(false);
    slice[0] = 123;
    slice[0] = 321;
}
#}
#update "volatile slice"
#check llvm {
define #...@test.entry(#...) #...{
#...
}

#...
define #...@test.entry2(#...) #...{
#...store volatile i16 123, ptr %#...
#...store volatile i16 321, ptr %#...
}

#}
