#zig build-exe {
--name test
-Mroot=test.zig
#}

#write test.zig {
const std = @import("std");
const string = @embedFile("string.txt");
pub fn main() !void {
    try std.Io.File.stdout().writeStreamingAll(io, string);
}
const io = std.Io.Threaded.global_single_threaded.io();
#}
#write string.txt {
Hello, World!
#}
#update
#check stdout {
Hello, World!
#}

#write string.txt {
Hello again, World!
#}
