#zig test {
--name test
-Mroot=test.zig
#}

#write test.zig {
const std = @import("std");

test {
    try foo(@typeInfo(@TypeOf(someFn)));
}

fn someFn(arg: ?*c_int) f64 {
    _ = arg;
    return 8;
}
fn foo(comptime info: std.builtin.Type) !void {
    try std.testing.expect(info.@"fn".param_types[0].? == ?*c_int);
}
#}
#update
#check stdout
