        // Features removed from LLVM
        .{
            .zig_name = "3dnow",
            .desc = "Enable 3DNow! instructions",
            .deps = .{
                "mmx",
                "prfchw",
            },
        },
        .{
            .zig_name = "3dnowa",
            .desc = "Enable 3DNow! Athlon instructions",
